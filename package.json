{
  "name": "brix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node --experimental-strip-types scripts/check-content.ts",
    "dev": "next dev",
    "build": "next build && node scripts/optimize-images.mjs",
    "start": "npx serve out -l 3210",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "media:poster": "node --experimental-strip-types scripts/build-video.ts",
    "check:placeholders": "node --experimental-strip-types scripts/check-content.ts",
    "qa": "node scripts/qa.mjs",
    "qa:interact": "node scripts/interact.mjs",
    "qa:nojs": "node scripts/nojs.mjs",
    "qa:motion": "node scripts/parity.mjs",
    "qa:vitals": "node scripts/vitals.mjs",
